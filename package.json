{
  "name": "twitter-clone",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "emulators": "node scripts/start-emulators.cjs",
    "emulators:migrate": "node scripts/migrate-firestore-to-emulator.cjs",
    "dev": "next dev -p 80",
    "dev:emulators": "concurrently npm:dev npm:emulators",
    "icons:material": "node scripts/generate-material-icons.cjs",
    "build": "next build",
    "start": "next start",
    "format": "prettier --check .",
    "lint": "next lint",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "prepare": "husky install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@headlessui/react": "^1.7.2",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^1.2.1",
    "firebase": "^9.9.4",
    "framer-motion": "^7.2.1",
    "katex": "^0.16.47",
    "lamejs": "^1.2.1",
    "linkpeek": "^2.1.5",
    "next": "^12.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.3.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.18",
    "react-textarea-autosize": "^8.3.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^1.3.0"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.48.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "18.6.4",
    "@types/react": "18.0.16",
    "@types/react-dom": "18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.8",
    "concurrently": "^8.2.1",
    "daisyui": "^4.12.24",
    "eslint": "8.57.0",
    "eslint-config-next": "12.2.4",
    "eslint-import-resolver-typescript": "^3.4.0",
    "eslint-plugin-import": "^2.26.0",
    "husky": "^8.0.1",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.16",
    "prettier": "^2.7.1",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "sass": "^1.54.4",
    "tailwindcss": "^3.2.4",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
